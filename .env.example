# PostgreSQL (pgAdmin / local)
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/hh_max_bot

# MAX messenger bot token
MAX_BOT_TOKEN=your_max_bot_token_here

# Yandex Cloud AI Studio
YANDEX_FOLDER_ID=your_yandex_folder_id
YANDEX_API_KEY=your_yandex_api_key

# HH.ru knowledge base (GitHub docs folder)
HH_DOCS_REPO_URL=https://github.com/hhru/api
HH_DOCS_BRANCH=master
HH_DOCS_PATH=docs

# Optional: path to store downloaded markdown locally
HH_DOCS_CACHE_DIR=data/knowledge
